package-as: LegacyVendor

enable-nolib-creation: no

ignore:
  - README.md
  - CURSEFORGE.md
  - CURSEFORGE.html
  - .pkgmeta
  - .github
  - .git
  - .gitignore
  - .gitattributes
  - "*.zip"
  - "*.bak"

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

move-folders:
  LegacyVendor/LegacyVendor: LegacyVendor
